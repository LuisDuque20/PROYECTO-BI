  </step>
  <step>
    <name>tin_empleado</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_rrhh_dw</connection>
    <sql>SELECT
    e.empleado_id,
    e.nombre_completo,
    e.genero,
    e.nivel_educativo,
    e.fecha_nacimiento,
    CAST(DATE_PART('year', AGE(CURRENT_DATE, e.fecha_nacimiento)) AS INTEGER) AS edad,
    CASE
        WHEN EXTRACT(YEAR FROM e.fecha_nacimiento) &lt; p.gen_x      THEN 'Baby Boomer'
        WHEN EXTRACT(YEAR FROM e.fecha_nacimiento) &lt; p.millennial THEN 'Gen X'
        WHEN EXTRACT(YEAR FROM e.fecha_nacimiento) &lt; p.gen_z      THEN 'Millennial'
        ELSE 'Gen Z'
    END AS grupo_generacional,
    ci.nombre AS ciudad,
    pa.nombre AS pais,
    c.fecha_contratacion,
    b.fecha_baja,
    b.motivo_baja,
    CASE WHEN b.empleado_id IS NULL AND c.fecha_contratacion &lt;= CURRENT_DATE THEN 1 ELSE 0 END AS es_activo,
    CASE WHEN c.fecha_contratacion > CURRENT_DATE THEN 1 ELSE 0 END AS contratacion_futura,
    ROUND(GREATEST(CAST(COALESCE(b.fecha_baja, CURRENT_DATE) - c.fecha_contratacion AS NUMERIC), 0) / 365.25, 2) AS antiguedad_anios
FROM stg.empleado e
JOIN stg.ciudad ci ON ci.ciudad_id = e.ciudad_id
JOIN stg.pais pa   ON pa.pais_id = ci.pais_id
LEFT JOIN stg.contratacion c ON c.empleado_id = e.empleado_id
LEFT JOIN stg.baja_empleado b ON b.empleado_id = e.empleado_id
CROSS JOIN (
    SELECT
        MAX(CASE WHEN clave = 'GEN_X_ANIO_INICIO'      THEN CAST(valor AS INTEGER) END) AS gen_x,
        MAX(CASE WHEN clave = 'MILLENNIAL_ANIO_INICIO' THEN CAST(valor AS INTEGER) END) AS millennial,
        MAX(CASE WHEN clave = 'GEN_Z_ANIO_INICIO'      THEN CAST(valor AS INTEGER) END) AS gen_z
    FROM dwh.parametros
) p</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
