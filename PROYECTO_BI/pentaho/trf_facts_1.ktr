<?xml version="1.0" encoding="UTF-8"?>
<transformation><info><name>trf_facts_1</name><description>Carga de fact_contratacion, fact_historial_laboral y fact_baja</description><extended_description/><trans_version/><trans_type>Normal</trans_type><directory>/</directory><parameters></parameters><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>N</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><created_user>-</created_user><modified_user>-</modified_user></info><notepads></notepads><connection><name>conn_rrhh_dw</name><server>${DB_HOST}</server><type>POSTGRESQL</type><access>Native</access><database>${DB_NAME}</database><port>${DB_PORT}</port><username>${DB_USER}</username><password>${DB_PASS}</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute><attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute><attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute><attribute><code>PORT_NUMBER</code><attribute>${DB_PORT}</attribute></attribute><attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute><attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes></connection><order><hop><from>tin_contratacion</from><to>fc_contratacion</to><enabled>Y</enabled></hop><hop><from>fc_contratacion</from><to>out_fact_contratacion</to><enabled>Y</enabled></hop><hop><from>tin_historial</from><to>fc_historial</to><enabled>Y</enabled></hop><hop><from>fc_historial</from><to>out_fact_historial_laboral</to><enabled>Y</enabled></hop><hop><from>tin_baja</from><to>fc_baja</to><enabled>Y</enabled></hop><hop><from>fc_baja</from><to>out_fact_baja</to><enabled>Y</enabled></hop></order><step><name>tin_contratacion</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>conn_rrhh_dw</connection><sql>SELECT
    c.contratacion_id,
    de.empleado_key,
    tc.fecha_key                                   AS fecha_contratacion_key,
    COALESCE(dd.departamento_key, -1)              AS departamento_key,
    COALESCE(dg.cargo_key, -1)                     AS cargo_key,
    COALESCE(dt.tipo_contrato_key, -1)             AS tipo_contrato_key,
    COALESCE(dl.condicion_laboral_key, -1)         AS condicion_laboral_key,
    c.salario_inicial,
    c.bono_pct,
    1                                              AS cantidad
FROM stg.contratacion c
LEFT JOIN dwh.dim_empleado          de ON de.empleado_id          = c.empleado_id
LEFT JOIN dwh.dim_tiempo            tc ON tc.fecha                = c.fecha_contratacion
LEFT JOIN dwh.dim_departamento      dd ON dd.departamento_id      = c.departamento_id
LEFT JOIN dwh.dim_cargo             dg ON dg.cargo_id             = c.cargo_id
LEFT JOIN dwh.dim_tipo_contrato     dt ON dt.tipo_contrato_id     = c.tipo_contrato_id
LEFT JOIN dwh.dim_condicion_laboral dl ON dl.condicion_laboral_id = c.condicion_laboral_id</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>120</xloc><yloc>80</yloc><draw>Y</draw></GUI></step><step><name>fc_contratacion</name><type>SystemInfo</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>fecha_carga</name><type>system date (fixed)</type></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>380</xloc><yloc>80</yloc><draw>Y</draw></GUI></step><step><name>out_fact_contratacion</name><type>TableOutput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>conn_rrhh_dw</connection><schema>dwh</schema><table>fact_contratacion</table><commit>1000</commit><truncate>Y</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>N</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>640</xloc><yloc>80</yloc><draw>Y</draw></GUI></step><step><name>tin_historial</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>conn_rrhh_dw</connection><sql>WITH orden AS (
    SELECT h.*,
           ROW_NUMBER() OVER (PARTITION BY h.empleado_id
                              ORDER BY h.fecha_inicio DESC, h.historial_id DESC) AS rn
    FROM stg.historial_laboral h
)
SELECT
    o.historial_id,
    de.empleado_key,
    COALESCE(dd.departamento_key, -1)       AS departamento_key,
    COALESCE(dg.cargo_key, -1)              AS cargo_key,
    COALESCE(dt.tipo_contrato_key, -1)      AS tipo_contrato_key,
    COALESCE(dl.condicion_laboral_key, -1)  AS condicion_laboral_key,
    ti.fecha_key                            AS fecha_inicio_key,
    CASE WHEN o.rn = 1 AND b.empleado_id IS NULL THEN NULL ELSE tf.fecha_key END AS fecha_fin_key,
    o.salario_mensual,
    o.bono_pct,
    ROUND(o.salario_mensual * COALESCE(o.bono_pct, 0) / 100, 2) AS bono_monto,
    CASE WHEN o.rn = 1 AND b.empleado_id IS NULL THEN 1 ELSE 0 END AS es_vigente
FROM orden o
LEFT JOIN stg.baja_empleado         b  ON b.empleado_id           = o.empleado_id
LEFT JOIN dwh.dim_empleado          de ON de.empleado_id          = o.empleado_id
LEFT JOIN dwh.dim_tiempo            ti ON ti.fecha                = o.fecha_inicio
LEFT JOIN dwh.dim_tiempo            tf ON tf.fecha                = o.fecha_fin
LEFT JOIN dwh.dim_departamento      dd ON dd.departamento_id      = o.departamento_id
LEFT JOIN dwh.dim_cargo             dg ON dg.cargo_id             = o.cargo_id
LEFT JOIN dwh.dim_tipo_contrato     dt ON dt.tipo_contrato_id     = o.tipo_contrato_id
LEFT JOIN dwh.dim_condicion_laboral dl ON dl.condicion_laboral_id = o.condicion_laboral_id</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>120</xloc><yloc>170</yloc><draw>Y</draw></GUI></step><step><name>fc_historial</name><type>SystemInfo</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>fecha_carga</name><type>system date (fixed)</type></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>380</xloc><yloc>170</yloc><draw>Y</draw></GUI></step><step><name>out_fact_historial_laboral</name><type>TableOutput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>conn_rrhh_dw</connection><schema>dwh</schema><table>fact_historial_laboral</table><commit>1000</commit><truncate>Y</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>N</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>640</xloc><yloc>170</yloc><draw>Y</draw></GUI></step><step><name>tin_baja</name><type>TableInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>conn_rrhh_dw</connection><sql>WITH ult AS (
    SELECT * FROM (
        SELECT h.*,
               ROW_NUMBER() OVER (PARTITION BY h.empleado_id
                                  ORDER BY h.fecha_inicio DESC, h.historial_id DESC) AS rn
        FROM stg.historial_laboral h
    ) x
    WHERE x.rn = 1
)
SELECT
    b.baja_id,
    de.empleado_key,
    tb.fecha_key                            AS fecha_baja_key,
    COALESCE(dt.tipo_contrato_key, -1)      AS tipo_contrato_key,
    COALESCE(dd.departamento_key, -1)       AS departamento_key,
    COALESCE(dg.cargo_key, -1)              AS cargo_key,
    b.motivo_baja,
    1                                       AS cantidad
FROM stg.baja_empleado b
LEFT JOIN ult                       u  ON u.empleado_id           = b.empleado_id
LEFT JOIN dwh.dim_empleado          de ON de.empleado_id          = b.empleado_id
LEFT JOIN dwh.dim_tiempo            tb ON tb.fecha                = b.fecha_baja
LEFT JOIN dwh.dim_tipo_contrato     dt ON dt.tipo_contrato_id     = u.tipo_contrato_id
LEFT JOIN dwh.dim_departamento      dd ON dd.departamento_id      = u.departamento_id
LEFT JOIN dwh.dim_cargo             dg ON dg.cargo_id             = u.cargo_id</sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>120</xloc><yloc>260</yloc><draw>Y</draw></GUI></step><step><name>fc_baja</name><type>SystemInfo</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>fecha_carga</name><type>system date (fixed)</type></field></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>380</xloc><yloc>260</yloc><draw>Y</draw></GUI></step><step><name>out_fact_baja</name><type>TableOutput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>conn_rrhh_dw</connection><schema>dwh</schema><table>fact_baja</table><commit>1000</commit><truncate>Y</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>N</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields></fields><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>640</xloc><yloc>260</yloc><draw>Y</draw></GUI></step><step_error_handling></step_error_handling><slave-step-copy-partition-distribution></slave-step-copy-partition-distribution><slave_transformation>N</slave_transformation></transformation>