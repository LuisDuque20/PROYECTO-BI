      <value_precision>-1</value_precision>
      <replace_field />
    </formula>
    <formula>
      <field_name>anio_mes</field_name>
      <formula_string>anio + "-" + (mes &lt; 10 ? "0" + mes : "" + mes)</formula_string>
      <value_type>String</value_type>
